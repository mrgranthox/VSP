generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RequestStatus {
  OPEN
  MATCHED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConversationType {
  DIRECT
  SERVICE_REQUEST
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum AdminRoleKey {
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum VisibilityScope {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
  CLOSED
}

enum SupportTicketStatus {
  OPEN
  ASSIGNED
  WAITING_USER
  WAITING_INTERNAL
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FraudSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum JobRunStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FollowTargetType {
  USER
  WORKER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  INFECTED
  EXPIRED
}

enum MediaCategory {
  avatar
  portfolio_image
  portfolio_video
  post_image
  post_video
  certification
  chat_attachment
  verification_doc
}

model User {
  id                            String                        @id @default(uuid())
  email                         String?                       @unique
  phone                         String?                       @unique
  passwordHash                  String?
  status                        UserStatus                    @default(ACTIVE)
  isEmailVerified               Boolean                       @default(false)
  isPhoneVerified               Boolean                       @default(false)
  lastLoginAt                   DateTime?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  adminAssignments              AdminUser[]                   @relation("AdminAssignments")
  adminAssignmentsGranted       AdminUser[]                   @relation("AdminAssignmentsGrantedBy")
  adminAuditLogs                AdminAuditLog[]
  analyticsEvents               AnalyticsEvent[]
  assignedModerationCases       ModerationCase[]              @relation("AssignedModerationCases")
  auditLogs                     AuditLog[]                    @relation("AuditLogsActor")
  bookingCancellationsMade      BookingCancellation[]         @relation("BookingCancellationsMadeBy")
  bookingReschedulesRequested   BookingReschedule[]           @relation("BookingReschedulesRequestedBy")
  bookingsAsCustomer            Booking[]                     @relation("CustomerBookings")
  commentLikes                  CommentLike[]
  commentReports                CommentReport[]
  comments                      Comment[]
  conversationParticipants      ConversationParticipant[]
  follows                       UserFollow[]                  @relation("UserFollows")
  fraudSignals                  FraudSignal[]
  identities                    UserIdentity[]
  messageReads                  MessageRead[]
  mfaConfig                     UserMfaConfig?
  mediaAssets                   MediaAsset[]
  moderationActionsPerformed    ModerationAction[]            @relation("ModerationActionsPerformed")
  notificationBroadcastsCreated NotificationBroadcast[]
  notificationPreference        NotificationPreference?
  notifications                 Notification[]
  paymentIntents                PaymentIntent[]
  posts                         Post[]
  postLikes                     PostLike[]
  postSaves                     PostSave[]
  profile                       UserProfile?
  pushDevices                   PushDevice[]
  reportsFiled                  Report[]
  reviewReplies                 ReviewReply[]
  reviewsReceived               Review[]                      @relation("ReviewsReceived")
  reviewsWritten                Review[]                      @relation("ReviewsWritten")
  searchImpressions             SearchImpression[]
  sentMessages                  Message[]                     @relation("UserSentMessages")
  serviceRequests               ServiceRequest[]              @relation("CustomerServiceRequests")
  serviceRequestStatusChanges   ServiceRequestStatusHistory[] @relation("ServiceRequestStatusChangedBy")
  sessions                      UserSession[]
  savedWorkers                  CustomerSavedWorker[]
  supportTicketMessages         SupportTicketMessage[]
  supportTicketsAssigned        SupportTicket[]               @relation("SupportTicketsAssigned")
  supportTicketsOpened          SupportTicket[]               @relation("SupportTicketsOpened")
  workerProfile                 WorkerProfile?
  ApiIdempotencyKey             ApiIdempotencyKey[]

  @@map("users")
}

model UserIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceType       String?
  ipAddress        String?
  mfaVerified      Boolean   @default(false)
  mfaMethod        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model UserMfaConfig {
  id                    String   @id @default(uuid())
  userId                String   @unique
  method                String
  totpSecretCiphertext  String?
  backupCodeHashes      String[] @default([])
  backupCodeCiphertexts String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa_configs")
}

model UserProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  bio         String?
  cityId      String?
  lat         Decimal?    @db.Decimal(10, 8)
  lng         Decimal?    @db.Decimal(11, 8)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  city        CityConfig? @relation(fields: [cityId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@map("user_profiles")
}

model MediaAsset {
  id                 String                @id @default(uuid())
  ownerUserId        String
  category           MediaCategory
  visibility         MediaVisibility
  mimeType           String
  sizeBytes          BigInt
  originalFilename   String?
  bucket             String
  storageKey         String                @unique
  uploadTokenHash    String?
  uploadUrlExpiresAt DateTime?
  uploadedAt         DateTime?
  confirmedAt        DateTime?
  status             MediaStatus           @default(PENDING_UPLOAD)
  variantUrls        Json?
  finalCdnUrl        String?
  failureReason      String?
  metadataJson       Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  ownerUser          User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  certifications     WorkerCertification[]
  messageAttachments MessageAttachment[]
  portfolioItems     WorkerPortfolioItem[]
  postMedia          PostMedia[]

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@index([category, status])
  @@map("media_assets")
}

model CustomerSavedWorker {
  id              String        @id @default(uuid())
  userId          String
  workerProfileId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, workerProfileId])
  @@index([workerProfileId])
  @@map("customer_saved_workers")
}

model UserFollow {
  id             String           @id @default(uuid())
  followerUserId String
  targetType     FollowTargetType
  targetId       String
  createdAt      DateTime         @default(now())
  followerUser   User             @relation("UserFollows", fields: [followerUserId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("user_follows")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  chatPushEnabled       Boolean  @default(true)
  requestPushEnabled    Boolean  @default(true)
  marketingEmailEnabled Boolean  @default(false)
  quietHoursStart       Int?
  quietHoursEnd         Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model WorkerProfile {
  id                     String                        @id @default(uuid())
  userId                 String                        @unique
  headline               String?
  bio                    String?
  experienceYears        Int                           @default(0)
  verificationStatus     VerificationStatus            @default(DRAFT)
  avgRating              Decimal                       @default(0) @db.Decimal(3, 2)
  totalReviews           Int                           @default(0)
  jobsCompleted          Int                           @default(0)
  responseRate           Decimal                       @default(0) @db.Decimal(5, 2)
  serviceRadiusKm        Int                           @default(10)
  isFeatured             Boolean                       @default(false)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  assignments            ServiceRequestAssignment[]
  bookings               Booking[]
  certifications         WorkerCertification[]
  featuredSubscriptions  WorkerFeaturedSubscription[]
  portfolioItems         WorkerPortfolioItem[]
  preferredForRequests   ServiceRequest[]              @relation("PreferredWorkerRequests")
  savedBy                CustomerSavedWorker[]
  searchImpressions      SearchImpression[]
  serviceAreas           WorkerServiceArea[]
  services               WorkerService[]
  subscriptionInvoices   WorkerSubscriptionInvoice[]
  tradeCategories        WorkerTradeCategory[]
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationRequests   WorkerVerificationRequest[]
  availabilityExceptions WorkerAvailabilityException[]
  availabilityRules      WorkerAvailabilityRule[]

  @@map("worker_profiles")
}

model WorkerTradeCategory {
  id              String        @id @default(uuid())
  workerProfileId String
  tradeCategoryId String
  tradeCategory   TradeCategory @relation(fields: [tradeCategoryId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, tradeCategoryId])
  @@index([tradeCategoryId])
  @@map("worker_trade_categories")
}

model WorkerService {
  id              String        @id @default(uuid())
  workerProfileId String
  title           String
  description     String?
  basePriceMinor  Int?
  currencyCode    String?
  isEnabled       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("worker_services")
}

model WorkerServiceArea {
  id              String        @id @default(uuid())
  workerProfileId String
  cityId          String?
  centerLat       Decimal?      @db.Decimal(10, 8)
  centerLng       Decimal?      @db.Decimal(11, 8)
  radiusKm        Int           @default(10)
  coverageMode    String        @default("CIRCLE")
  createdAt       DateTime      @default(now())
  city            CityConfig?   @relation(fields: [cityId], references: [id])
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@index([cityId])
  @@map("worker_service_areas")
}

model WorkerAvailabilityRule {
  id              String        @id @default(uuid())
  workerProfileId String
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int
  timezone        String
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, dayOfWeek])
  @@map("worker_availability_rules")
}

model WorkerAvailabilityException {
  id              String        @id @default(uuid())
  workerProfileId String
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, startsAt])
  @@map("worker_availability_exceptions")
}

model WorkerPortfolioItem {
  id              String        @id @default(uuid())
  workerProfileId String
  mediaAssetId    String?
  title           String?
  caption         String?
  mediaUrl        String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  mediaAsset      MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, sortOrder])
  @@index([mediaAssetId])
  @@map("worker_portfolio_items")
}

model WorkerCertification {
  id                 String             @id @default(uuid())
  workerProfileId    String
  mediaAssetId       String?
  title              String
  issuer             String?
  certificateUrl     String
  issuedOn           DateTime?          @db.Date
  expiresOn          DateTime?          @db.Date
  verificationStatus VerificationStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  mediaAsset         MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  workerProfile      WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, verificationStatus])
  @@index([mediaAssetId])
  @@map("worker_certifications")
}

model WorkerVerificationRequest {
  id              String             @id @default(uuid())
  workerProfileId String
  status          VerificationStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime           @default(now())
  workerProfile   WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, status])
  @@map("worker_verification_requests")
}

model Post {
  id           String          @id @default(uuid())
  authorUserId String
  body         String
  visibility   VisibilityScope @default(PUBLIC)
  isDeleted    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  authorUser   User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        PostLike[]
  media        PostMedia[]
  saves        PostSave[]

  @@index([authorUserId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id           String      @id @default(uuid())
  postId       String
  mediaAssetId String?
  mediaUrl     String
  mediaType    String
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  post         Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@index([mediaAssetId])
  @@map("post_media")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_saves")
}

model Comment {
  id              String          @id @default(uuid())
  postId          String?
  reviewId        String?
  parentCommentId String?
  authorUserId    String
  body            String
  isDeleted       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  authorUser      User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  likes           CommentLike[]
  parentComment   Comment?        @relation("CommentReplies", fields: [parentCommentId], references: [id])
  post            Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports         CommentReport[]
  replies         Comment[]       @relation("CommentReplies")
  review          Review?         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([reviewId, createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model CommentReport {
  id             String   @id @default(uuid())
  commentId      String
  reporterUserId String
  reason         String
  createdAt      DateTime @default(now())
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterUser   User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_reports")
}

model Conversation {
  id               String                    @id @default(uuid())
  conversationType ConversationType
  serviceRequestId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  messages         Message[]
  participants     ConversationParticipant[]
  serviceRequest   ServiceRequest?           @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([conversationType, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                String       @id @default(uuid())
  conversationId    String
  userId            String
  joinedAt          DateTime     @default(now())
  lastReadMessageId String?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadMessage   Message?     @relation("ConversationParticipantLastReadMessage", fields: [lastReadMessageId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("conversation_participants")
}

model Message {
  id                     String                    @id @default(uuid())
  conversationId         String
  senderId               String
  messageType            MessageType               @default(TEXT)
  body                   String?
  createdAt              DateTime                  @default(now())
  attachments            MessageAttachment[]
  conversation           Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadByParticipants ConversationParticipant[] @relation("ConversationParticipantLastReadMessage")
  reads                  MessageRead[]
  sender                 User                      @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id           String      @id @default(uuid())
  messageId    String
  mediaAssetId String?
  fileUrl      String
  mimeType     String
  sizeBytes    BigInt?
  createdAt    DateTime    @default(now())
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  message      Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_reads")
}

model ServiceRequest {
  id                       String                        @id @default(uuid())
  customerUserId           String
  tradeCategoryId          String?
  preferredWorkerProfileId String?
  title                    String
  description              String
  locationText             String?
  lat                      Decimal?                      @db.Decimal(10, 8)
  lng                      Decimal?                      @db.Decimal(11, 8)
  status                   RequestStatus                 @default(OPEN)
  requestedAt              DateTime                      @default(now())
  scheduledAt              DateTime?
  expiresAt                DateTime?
  assignments              ServiceRequestAssignment[]
  booking                  Booking?
  conversations            Conversation[]
  customerUser             User                          @relation("CustomerServiceRequests", fields: [customerUserId], references: [id], onDelete: Cascade)
  items                    ServiceRequestItem[]
  preferredWorkerProfile   WorkerProfile?                @relation("PreferredWorkerRequests", fields: [preferredWorkerProfileId], references: [id])
  statusHistory            ServiceRequestStatusHistory[]
  tradeCategory            TradeCategory?                @relation(fields: [tradeCategoryId], references: [id])

  @@index([customerUserId, requestedAt])
  @@index([status, requestedAt])
  @@map("service_requests")
}

model ServiceRequestItem {
  id               String         @id @default(uuid())
  serviceRequestId String
  label            String
  quantity         Int            @default(1)
  note             String?
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("service_request_items")
}

model ServiceRequestAssignment {
  id               String           @id @default(uuid())
  serviceRequestId String
  workerProfileId  String
  assignmentStatus AssignmentStatus @default(PENDING)
  assignedAt       DateTime         @default(now())
  respondedAt      DateTime?
  serviceRequest   ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  workerProfile    WorkerProfile    @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, assignmentStatus])
  @@index([workerProfileId, assignmentStatus])
  @@map("service_request_assignments")
}

model ServiceRequestStatusHistory {
  id               String         @id @default(uuid())
  serviceRequestId String
  fromStatus       RequestStatus?
  toStatus         RequestStatus
  changedByUserId  String?
  changedAt        DateTime       @default(now())
  changedByUser    User?          @relation("ServiceRequestStatusChangedBy", fields: [changedByUserId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, changedAt])
  @@map("service_request_status_history")
}

model Booking {
  id               String                @id @default(uuid())
  serviceRequestId String                @unique
  workerProfileId  String
  customerUserId   String
  scheduledStart   DateTime
  scheduledEnd     DateTime
  status           BookingStatus         @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cancellations    BookingCancellation[]
  customerUser     User                  @relation("CustomerBookings", fields: [customerUserId], references: [id], onDelete: Cascade)
  paymentIntents   PaymentIntent[]
  reschedules      BookingReschedule[]
  review           Review?
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  workerProfile    WorkerProfile         @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, scheduledStart])
  @@index([customerUserId, scheduledStart])
  @@map("bookings")
}

model BookingReschedule {
  id                String           @id @default(uuid())
  bookingId         String
  requestedByUserId String
  oldStart          DateTime
  oldEnd            DateTime
  newStart          DateTime
  newEnd            DateTime
  status            RescheduleStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedByUser   User             @relation("BookingReschedulesRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_reschedules")
}

model BookingCancellation {
  id                String   @id @default(uuid())
  bookingId         String
  cancelledByUserId String
  reason            String?
  createdAt         DateTime @default(now())
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledByUser   User     @relation("BookingCancellationsMadeBy", fields: [cancelledByUserId], references: [id], onDelete: Cascade)

  @@map("booking_cancellations")
}

model Review {
  id              String                 @id @default(uuid())
  bookingId       String                 @unique
  reviewerUserId  String
  revieweeUserId  String
  rating          Int
  body            String?
  createdAt       DateTime               @default(now())
  booking         Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  comments        Comment[]
  dimensionScores ReviewDimensionScore[]
  replies         ReviewReply[]
  reviewerUser    User                   @relation("ReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  revieweeUser    User                   @relation("ReviewsReceived", fields: [revieweeUserId], references: [id], onDelete: Cascade)

  @@index([revieweeUserId, createdAt])
  @@map("reviews")
}

model ReviewDimensionScore {
  id           String @id @default(uuid())
  reviewId     String
  dimensionKey String
  score        Int
  review       Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, dimensionKey])
  @@map("review_dimension_scores")
}

model ReviewReply {
  id           String   @id @default(uuid())
  reviewId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@map("review_replies")
}

model Report {
  id              String             @id @default(uuid())
  reporterUserId  String
  entityType      String
  entityId        String
  reason          String
  severity        ModerationSeverity @default(MEDIUM)
  status          ReportStatus       @default(OPEN)
  createdAt       DateTime           @default(now())
  moderationCases ModerationCase[]
  reporterUser    User               @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([reporterUserId, createdAt])
  @@map("reports")
}

model ModerationCase {
  id                  String               @id @default(uuid())
  reportId            String?
  assignedAdminUserId String?
  status              ModerationCaseStatus @default(OPEN)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  actions             ModerationAction[]
  assignedAdminUser   User?                @relation("AssignedModerationCases", fields: [assignedAdminUserId], references: [id])
  report              Report?              @relation(fields: [reportId], references: [id])

  @@index([status, createdAt])
  @@map("moderation_cases")
}

model ModerationAction {
  id                     String         @id @default(uuid())
  moderationCaseId       String
  performedByAdminUserId String
  actionType             String
  entityType             String
  entityId               String
  notes                  String?
  createdAt              DateTime       @default(now())
  moderationCase         ModerationCase @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  performedByAdminUser   User           @relation("ModerationActionsPerformed", fields: [performedByAdminUserId], references: [id], onDelete: Cascade)

  @@index([moderationCaseId, createdAt])
  @@map("moderation_actions")
}

model FraudSignal {
  id         String            @id @default(uuid())
  userId     String?
  entityType String?
  entityId   String?
  signalKey  String
  score      Decimal           @db.Decimal(6, 2)
  status     FraudSignalStatus @default(OPEN)
  createdAt  DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id])

  @@index([signalKey, status])
  @@map("fraud_signals")
}

model Notification {
  id               String              @id @default(uuid())
  userId           String
  channel          NotificationChannel @default(IN_APP)
  notificationType String
  payloadJson      Json
  isRead           Boolean             @default(false)
  readAt           DateTime?
  createdAt        DateTime            @default(now())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model PushDevice {
  id          String    @id @default(uuid())
  userId      String
  deviceToken String    @unique
  platform    String
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("push_devices")
}

model PaymentIntent {
  id                  String                       @id @default(uuid())
  userId              String
  bookingId           String?
  amountMinor         Int
  currencyCode        String
  status              PaymentIntentStatus          @default(CREATED)
  providerRef         String?
  createdAt           DateTime                     @default(now())
  booking             Booking?                     @relation(fields: [bookingId], references: [id])
  platformFees        PlatformFee[]
  sourceSubscriptions WorkerFeaturedSubscription[] @relation("FeaturedSubscriptionSourcePaymentIntent")
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_intents")
}

model PlatformFee {
  id              String        @id @default(uuid())
  paymentIntentId String
  feeMinor        Int
  feeType         String
  createdAt       DateTime      @default(now())
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("platform_fees")
}

model WorkerFeaturedSubscription {
  id                    String             @id @default(uuid())
  workerProfileId       String
  startsAt              DateTime
  endsAt                DateTime
  status                SubscriptionStatus
  sourcePaymentIntentId String?
  createdAt             DateTime           @default(now())
  sourcePaymentIntent   PaymentIntent?     @relation("FeaturedSubscriptionSourcePaymentIntent", fields: [sourcePaymentIntentId], references: [id])
  workerProfile         WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, status])
  @@index([status, endsAt])
  @@map("worker_featured_subscriptions")
}

model WorkerSubscriptionInvoice {
  id              String        @id @default(uuid())
  workerProfileId String
  amountMinor     Int
  currencyCode    String
  status          InvoiceStatus
  providerRef     String?
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@map("worker_subscription_invoices")
}

model SupportTicket {
  id                    String                 @id @default(uuid())
  openedByUserId        String
  relatedEntityType     String?
  relatedEntityId       String?
  status                SupportTicketStatus    @default(OPEN)
  priority              SupportPriority        @default(MEDIUM)
  subject               String
  body                  String
  assignedSupportUserId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignedSupportUser   User?                  @relation("SupportTicketsAssigned", fields: [assignedSupportUserId], references: [id])
  messages              SupportTicketMessage[]
  openedByUser          User                   @relation("SupportTicketsOpened", fields: [openedByUserId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id              String        @id @default(uuid())
  supportTicketId String
  authorUserId    String
  body            String
  isInternalNote  Boolean       @default(false)
  createdAt       DateTime      @default(now())
  authorUser      User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
  @@map("support_ticket_messages")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  sessionId  String?
  eventName  String
  entityType String?
  entityId   String?
  propsJson  Json
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

model SearchImpression {
  id              String         @id @default(uuid())
  userId          String?
  queryText       String?
  workerProfileId String?
  rankPosition    Int
  cityId          String?
  createdAt       DateTime       @default(now())
  city            CityConfig?    @relation(fields: [cityId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  workerProfile   WorkerProfile? @relation(fields: [workerProfileId], references: [id])

  @@index([workerProfileId, createdAt])
  @@map("search_impressions")
}

model AdminRole {
  id              String                @id @default(uuid())
  roleKey         AdminRoleKey          @unique
  label           String
  description     String?
  rolePermissions AdminRolePermission[]
  userAssignments AdminUser[]

  @@map("admin_roles")
}

model AdminPermission {
  id              String                @id @default(uuid())
  permissionKey   String                @unique
  description     String?
  rolePermissions AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id           String          @id @default(uuid())
  roleId       String
  permissionId String
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id               String    @id @default(uuid())
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  assignedByUser   User?     @relation("AdminAssignmentsGrantedBy", fields: [assignedByUserId], references: [id])
  role             AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user             User      @relation("AdminAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  diffJson    Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation("AuditLogsActor", fields: [actorUserId], references: [id])

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  action       String
  entityType   String?
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())
  adminUser    User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

model TradeCategory {
  id                    String                @id @default(uuid())
  slug                  String                @unique
  name                  String
  iconUrl               String?
  isEnabled             Boolean               @default(true)
  serviceRequests       ServiceRequest[]
  workerTradeCategories WorkerTradeCategory[]

  @@map("trade_categories")
}

model CityConfig {
  id                    String              @id @default(uuid())
  slug                  String              @unique
  name                  String
  countryCode           String
  currencyCode          String
  timezone              String
  defaultSearchRadiusKm Int
  isEnabled             Boolean             @default(true)
  searchImpressions     SearchImpression[]
  userProfiles          UserProfile[]
  workerServiceAreas    WorkerServiceArea[]

  @@map("city_configs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  configKey String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model FeatureFlag {
  id             String  @id @default(uuid())
  flagKey        String  @unique
  description    String?
  defaultEnabled Boolean @default(false)
  rolloutJson    Json?

  @@map("feature_flags")
}

model JobRun {
  id           String       @id @default(uuid())
  jobName      String
  queueName    String
  status       JobRunStatus
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  metadataJson Json?

  @@index([queueName, startedAt])
  @@map("job_runs")
}

model ApiIdempotencyKey {
  id                   String   @id @default(uuid())
  idempotencyKey       String   @unique
  userId               String?
  requestHash          String
  responseSnapshotJson Json?
  expiresAt            DateTime
  user                 User?    @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("api_idempotency_keys")
}

model NotificationBroadcast {
  id                  String    @id @default(uuid())
  createdByAdminId    String
  targetAudience      String
  targetId            String?
  title               String
  body                String
  channel             String
  estimatedRecipients Int
  actualRecipients    Int?
  status              String    @default("QUEUED")
  scheduledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  createdByAdmin      User      @relation(fields: [createdByAdminId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notification_broadcasts")
}
