{
  "name": "vsp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vocational Services Platform backend foundation scaffold",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/bootstrap/api.ts",
    "workers": "tsx src/bootstrap/workers.ts",
    "gateway": "tsx src/bootstrap/gateway.ts",
    "build": "tsc -p tsconfig.json",
    "db:seed": "prisma db seed",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "api:contracts:generate": "tsx scripts/generate-api-artifacts.ts",
    "api:contracts:check": "tsx scripts/generate-api-artifacts.ts --check",
    "ops:backup": "tsx scripts/db-backup.ts",
    "ops:restore:verify": "tsx scripts/db-restore-verify.ts",
    "ops:secrets:generate": "tsx scripts/generate-secrets.ts",
    "ops:mfa:rewrap": "tsx scripts/mfa-rewrap.ts",
    "ops:error-reporting:verify": "tsx scripts/verify-error-reporting.ts",
    "ops:tracing:verify": "tsx scripts/verify-tracing.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "start": "node dist/src/bootstrap/api.js",
    "smoke:test": "tsx scripts/smoke-test.ts",
    "test": "node --import ./src/test/setup-env.js --import tsx --test --test-concurrency=1 $(find src -name '*.test.ts' -print)",
    "test:auth": "node --import ./src/test/setup-env.js --import tsx --test src/modules/auth/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.45.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "twilio": "^5.5.4",
    "typesense": "^1.8.2",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
