NODE_ENV=development
APP_NAME=vsp-backend
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vsp_dev?schema=public
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_KEY_PREFIX=vsp:
EVENT_BUS_MODE=inline
BACKGROUND_WORKERS_ENABLED=false
PUSH_STALE_TOKEN_DAYS=30
WS_GATEWAY_PORT=3002
WS_GATEWAY_PATH=/ws
WS_AUTH_TIMEOUT_MS=10000
WS_PRESENCE_TTL_SECONDS=45
WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MESSAGE_RATE_LIMIT_MAX=30
WS_MESSAGE_RATE_LIMIT_WINDOW_MS=60000
WS_REDIS_CHANNEL=ws:events
RATE_LIMIT_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_MAX_AGE_SECONDS=86400
CDN_BASE_URL=https://cdn.vocationalplatform.local
STORAGE_LOCAL_ROOT=.tmp/storage
STORAGE_PENDING_MEDIA_TTL_SECONDS=1800
STORAGE_PRIVATE_READ_URL_TTL_SECONDS=3600
STORAGE_SIGNING_SECRET=change-me
# Prefer *_FILE variants in production, for example:
# STORAGE_SIGNING_SECRET_FILE=/run/secrets/storage_signing_secret.secret
MEDIA_PROCESS_INLINE=true
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64_PREVIOUS=
# JWT_PRIVATE_KEY_BASE64_FILE=/run/secrets/jwt_private_key_base64.secret
# JWT_PUBLIC_KEY_BASE64_FILE=/run/secrets/jwt_public_key_base64.secret
# JWT_PUBLIC_KEY_BASE64_PREVIOUS_FILE=/run/secrets/jwt_public_key_base64_previous.secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=vsp-backend
JWT_AUDIENCE=vsp-api
MFA_ENCRYPTION_KEY_BASE64=
MFA_ENCRYPTION_KEY_BASE64_PREVIOUS=
# MFA_ENCRYPTION_KEY_BASE64_FILE=/run/secrets/mfa_encryption_key_base64.secret
# MFA_ENCRYPTION_KEY_BASE64_PREVIOUS_FILE=/run/secrets/mfa_encryption_key_base64_previous.secret
MFA_ISSUER=Vocational Services Platform
ADMIN_MFA_STEP_UP_TTL_SECONDS=900
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_AUTH_TOKEN_FILE=/run/secrets/twilio_auth_token.secret
TWILIO_VERIFY_MOCK_MODE=true
TWILIO_VERIFY_CODE_TTL_SECONDS=300
INTERNAL_API_KEY=
# INTERNAL_API_KEY_FILE=/run/secrets/internal_api_key.secret
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_CONSOLE_EXPORTER_ENABLED=false
OTEL_TRACES_SAMPLER_RATIO=1
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_FLUSH_TIMEOUT_MS=2000
LOG_LEVEL=info
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
# ALERT_WEBHOOK_BEARER_TOKEN_FILE=/run/secrets/alert_webhook_bearer_token.secret
ALERT_WEBHOOK_TIMEOUT_MS=3000
TYPESENSE_HOST=
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
# TYPESENSE_API_KEY_FILE=/run/secrets/typesense_api_key.secret
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2
TYPESENSE_WORKERS_COLLECTION=workers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TYPESENSE_INDEXING_BATCH_SIZE=500
CRON_NOTIFICATION_FANOUT=*/5 * * * *
CRON_ANALYTICS_ROLLUP=0 * * * *
CRON_SUBSCRIPTION_EXPIRY=*/15 * * * *
CRON_FRAUD_EVALUATOR=0 * * * *
CRON_SEARCH_REINDEX=0 2 * * *
CRON_AUDIT_INTEGRITY=0 3 * * *
CRON_TOKEN_CLEANUP=0 4 * * *
CRON_PARTITION_CREATE=0 1 1 * *
CRON_PENDING_MEDIA_CLEANUP=*/10 * * * *
