global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090

  - job_name: vsp_api
    metrics_path: /api/v1/internal/metrics
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY__
    static_configs:
      - targets:
          - api:3000

  - job_name: vsp_gateway
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY__
    static_configs:
      - targets:
          - gateway:3002
