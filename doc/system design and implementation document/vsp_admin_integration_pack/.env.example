# =============================================================================
# VOCATIONAL SERVICES PLATFORM — Complete Environment Variable Reference
# =============================================================================
# Copy this file to .env.local (development) or inject via secrets manager
# All variables marked REQUIRED must be set. Optional variables have defaults.
# NEVER commit real values to source control. Use SOPS or AWS Secrets Manager.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development                          # REQUIRED: development | staging | production
APP_NAME=vocational-services-platform         # REQUIRED: used in logs and notifications
APP_VERSION=1.0.0                             # REQUIRED: injected by CI at build time
PORT=3000                                     # REQUIRED: HTTP server port (api-server)
WS_PORT=3001                                  # REQUIRED: WebSocket server port (ws-gateway)
API_BASE_URL=http://localhost:3000            # REQUIRED: full base URL for this service
FRONTEND_WEB_URL=http://localhost:3000        # REQUIRED: web client origin (used in CORS + emails)
FRONTEND_MOBILE_SCHEME=vocationalapp          # REQUIRED: deep link scheme for mobile (vocationalapp://)

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL via Supabase
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/vocational_dev?schema=public
# REQUIRED: Prisma primary connection. Use PgBouncer URL in staging/production.
# Production format: postgresql://USER:PASS@pgbouncer-host:5432/DB?pgbouncer=true&connection_limit=1

DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/vocational_dev?schema=public
# REQUIRED: Prisma direct connection (bypasses PgBouncer) — used only for migrations.
# Set to Supabase direct connection string in production.

DATABASE_READ_REPLICA_URL=postgresql://postgres:password@localhost:5432/vocational_dev?schema=public
# OPTIONAL: Read replica URL for non-critical reads. Falls back to DATABASE_URL if not set.

DATABASE_MAX_CONNECTIONS=10
# OPTIONAL: Prisma connection pool size per pod. Default 10. PgBouncer handles pooling externally.

# Supabase-specific
SUPABASE_URL=http://localhost:54321           # REQUIRED: Supabase project URL
SUPABASE_ANON_KEY=your-anon-key-here         # REQUIRED: Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# REQUIRED: Service role key — backend only, NEVER expose to clients

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379             # REQUIRED: Primary Redis connection
REDIS_PASSWORD=                              # OPTIONAL: Redis AUTH password (blank = no auth)
REDIS_TLS=false                              # OPTIONAL: Enable TLS for Redis (true in production)
REDIS_KEY_PREFIX=vsp:                        # OPTIONAL: Prefix for all Redis keys. Default: vsp:
REDIS_CACHE_DB=0                             # OPTIONAL: Redis DB index for cache. Default: 0
REDIS_QUEUE_DB=1                             # OPTIONAL: Redis DB index for BullMQ queues. Default: 1
REDIS_SESSION_DB=2                           # OPTIONAL: Redis DB index for sessions/presence. Default: 2

# Redis Sentinel (production HA)
REDIS_SENTINEL_ENABLED=false                 # OPTIONAL: Enable Sentinel mode. Default: false
REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
REDIS_SENTINEL_MASTER_NAME=mymaster

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_ALGORITHM=RS256                          # REQUIRED: Must be RS256. Never HS256 in production.
JWT_ACCESS_TOKEN_TTL_SECONDS=900             # REQUIRED: 15 minutes = 900. Do not exceed 3600.
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000        # REQUIRED: 30 days = 2592000.

# RS256 Asymmetric Keys — use AWS Secrets Manager in production
JWT_PRIVATE_KEY_BASE64=                      # REQUIRED: Base64-encoded RSA private key (PKCS8 PEM)
JWT_PUBLIC_KEY_BASE64=                       # REQUIRED: Base64-encoded RSA public key (SPKI PEM)
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Encode: base64 -w 0 private.pem && base64 -w 0 public.pem

JWT_ISSUER=vocational-services-platform      # OPTIONAL: JWT iss claim. Default: APP_NAME
JWT_AUDIENCE=vsp-api                         # OPTIONAL: JWT aud claim. Default: vsp-api

# MFA
MFA_TOTP_ISSUER=VocationalPlatform           # REQUIRED: Name shown in authenticator apps
MFA_BACKUP_CODE_COUNT=8                      # OPTIONAL: Number of backup codes per user. Default: 8
MFA_BACKUP_CODE_LENGTH=10                    # OPTIONAL: Length of each backup code. Default: 10

# -----------------------------------------------------------------------------
# TYPESENSE SEARCH
# -----------------------------------------------------------------------------
TYPESENSE_HOST=localhost                     # REQUIRED: Typesense host
TYPESENSE_PORT=8108                          # REQUIRED: Typesense port. Default: 8108
TYPESENSE_PROTOCOL=http                      # REQUIRED: http | https
TYPESENSE_API_KEY=xyz-admin-key              # REQUIRED: Admin API key (server-side only)
TYPESENSE_SEARCH_ONLY_API_KEY=xyz-search-key # OPTIONAL: Read-only key (can be exposed to clients)
TYPESENSE_COLLECTION_WORKERS=workers         # OPTIONAL: Workers collection name. Default: workers
TYPESENSE_COLLECTION_POSTS=posts             # OPTIONAL: Posts collection name. Default: posts
TYPESENSE_REINDEX_CRON=0 2 * * *             # OPTIONAL: Full reindex cron. Default: nightly 02:00 UTC
TYPESENSE_INDEXING_BATCH_SIZE=500            # OPTIONAL: Documents per batch. Default: 500

# Typesense HA cluster (production — 3 nodes)
TYPESENSE_NODES=localhost:8108:http,localhost:8109:http,localhost:8110:http
# OPTIONAL: Comma-separated host:port:protocol for HA cluster mode

# -----------------------------------------------------------------------------
# OPENAI (Vector Embeddings for Recommendations)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...                        # REQUIRED: For generating worker profile embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small # OPTIONAL: Default: text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536             # OPTIONAL: Must match Typesense collection. Default: 1536
OPENAI_EMBEDDING_BATCH_SIZE=50               # OPTIONAL: Profiles per embedding API call. Default: 50

# -----------------------------------------------------------------------------
# STORAGE — Supabase Storage / S3-compatible
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=supabase                    # REQUIRED: supabase | s3 | gcs
STORAGE_REGION=us-east-1                     # REQUIRED: Cloud region for storage

# Supabase Storage
STORAGE_SUPABASE_URL=http://localhost:54321  # REQUIRED: Same as SUPABASE_URL
STORAGE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS S3 (alternative)
STORAGE_S3_BUCKET=vocational-platform-media  # REQUIRED if STORAGE_PROVIDER=s3
STORAGE_S3_ACCESS_KEY_ID=                    # REQUIRED if STORAGE_PROVIDER=s3
STORAGE_S3_SECRET_ACCESS_KEY=                # REQUIRED if STORAGE_PROVIDER=s3

# Bucket names (must exist before deployment)
STORAGE_BUCKET_AVATARS=avatars               # REQUIRED
STORAGE_BUCKET_PORTFOLIO=portfolio           # REQUIRED
STORAGE_BUCKET_POST_MEDIA=post-media         # REQUIRED
STORAGE_BUCKET_CERTIFICATIONS=certifications # REQUIRED (private)
STORAGE_BUCKET_CHAT_ATTACHMENTS=chat-attachments # REQUIRED (private)
STORAGE_BUCKET_VERIFICATION_DOCS=verification-docs # REQUIRED (private)

# Signed URL TTLs (seconds)
STORAGE_UPLOAD_URL_TTL_SECONDS=1800          # OPTIONAL: Signed upload URL expiry. Default: 30 min
STORAGE_PRIVATE_READ_URL_TTL_SECONDS=3600    # OPTIONAL: Signed read URL expiry. Default: 1 hour
STORAGE_PENDING_MEDIA_TTL_SECONDS=1800       # OPTIONAL: Pending media record expiry. Default: 30 min

# CDN
CDN_BASE_URL=https://cdn.vocationalplatform.com # REQUIRED: CDN origin for public media
CDN_ENABLED=false                            # OPTIONAL: Disable CDN in development. Default: false

# -----------------------------------------------------------------------------
# MEDIA PROCESSING
# -----------------------------------------------------------------------------
MEDIA_MAX_AVATAR_SIZE_MB=5                   # OPTIONAL: Default: 5
MEDIA_MAX_PORTFOLIO_IMAGE_SIZE_MB=50         # OPTIONAL: Default: 50
MEDIA_MAX_PORTFOLIO_VIDEO_SIZE_MB=200        # OPTIONAL: Default: 200
MEDIA_MAX_POST_IMAGE_SIZE_MB=50              # OPTIONAL: Default: 50
MEDIA_MAX_POST_VIDEO_SIZE_MB=200             # OPTIONAL: Default: 200
MEDIA_MAX_CERTIFICATION_SIZE_MB=20           # OPTIONAL: Default: 20
MEDIA_MAX_CHAT_ATTACHMENT_SIZE_MB=25         # OPTIONAL: Default: 25
MEDIA_VIDEO_MAX_DURATION_SECONDS=300         # OPTIONAL: 5 minutes max. Default: 300
MEDIA_VIDEO_OUTPUT_RESOLUTION=720p           # OPTIONAL: 720p | 1080p. Default: 720p
MEDIA_IMAGE_WEBP_QUALITY=85                  # OPTIONAL: WebP quality 1-100. Default: 85

# ClamAV Virus Scanner
CLAMAV_HOST=localhost                        # REQUIRED: ClamAV clamd host
CLAMAV_PORT=3310                             # REQUIRED: ClamAV TCP port. Default: 3310
CLAMAV_ENABLED=true                          # OPTIONAL: Disable in dev to skip scanning. Default: true
CLAMAV_SCAN_TIMEOUT_MS=30000                 # OPTIONAL: Scan timeout. Default: 30 seconds

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS
# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Android + Web)
FCM_PROJECT_ID=your-firebase-project-id      # REQUIRED
FCM_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com # REQUIRED
FCM_PRIVATE_KEY_BASE64=                      # REQUIRED: Base64-encoded FCM service account private key
FCM_BATCH_SIZE=500                           # OPTIONAL: Devices per batch call. Default: 500

# Apple Push Notification service (iOS)
APNS_KEY_ID=XXXXXXXXXX                       # REQUIRED for iOS: APNs key ID
APNS_TEAM_ID=XXXXXXXXXX                      # REQUIRED for iOS: Apple developer team ID
APNS_BUNDLE_ID=com.vocationalplatform.app    # REQUIRED for iOS: App bundle identifier
APNS_PRIVATE_KEY_BASE64=                     # REQUIRED for iOS: Base64-encoded APNs .p8 key
APNS_PRODUCTION=false                        # OPTIONAL: false = sandbox, true = production

# Push delivery settings
PUSH_STALE_TOKEN_DAYS=60                     # OPTIONAL: Days before unused token pruned. Default: 60

# -----------------------------------------------------------------------------
# EMAIL — SendGrid
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG.xxxxx                    # REQUIRED: SendGrid API key
EMAIL_FROM_ADDRESS=noreply@vocationalplatform.com # REQUIRED: Sender address
EMAIL_FROM_NAME=Vocational Platform          # REQUIRED: Sender display name
EMAIL_REPLY_TO=support@vocationalplatform.com # OPTIONAL: Reply-to address

# Email template IDs (SendGrid dynamic templates)
EMAIL_TEMPLATE_WELCOME=d-xxxxxxxxxxxxxxxx    # REQUIRED
EMAIL_TEMPLATE_VERIFY_EMAIL=d-xxxxxxxxxxxxxxxx # REQUIRED
EMAIL_TEMPLATE_RESET_PASSWORD=d-xxxxxxxxxxxxxxxx # REQUIRED
EMAIL_TEMPLATE_BOOKING_CONFIRMED=d-xxxxxxxxxxxxxxxx # REQUIRED
EMAIL_TEMPLATE_VERIFICATION_APPROVED=d-xxxxxxxxxxxxxxxx # REQUIRED
EMAIL_TEMPLATE_VERIFICATION_REJECTED=d-xxxxxxxxxxxxxxxx # REQUIRED
EMAIL_TEMPLATE_FEATURED_EXPIRING=d-xxxxxxxxxxxxxxxx # REQUIRED

# -----------------------------------------------------------------------------
# SMS — Twilio
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # REQUIRED for SMS OTP
TWILIO_AUTH_TOKEN=                           # REQUIRED for SMS OTP
TWILIO_PHONE_NUMBER=+1234567890             # REQUIRED: Twilio sending number
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # REQUIRED for Twilio Verify (MFA)
SMS_OTP_TTL_SECONDS=300                      # OPTIONAL: OTP expiry. Default: 5 minutes

# -----------------------------------------------------------------------------
# PAYMENT PROVIDER — Stripe / Paystack / Flutterwave
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe                      # REQUIRED: stripe | paystack | flutterwave

# Stripe
STRIPE_SECRET_KEY=sk_test_...               # REQUIRED if PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...          # REQUIRED: Returned to client for Stripe.js
STRIPE_WEBHOOK_SECRET=whsec_...             # REQUIRED: Webhook signature secret
STRIPE_API_VERSION=2024-06-20               # OPTIONAL: Pin API version

# Paystack (West Africa)
PAYSTACK_SECRET_KEY=sk_test_...             # REQUIRED if PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=pk_test_...             # REQUIRED
PAYSTACK_WEBHOOK_SECRET=                    # REQUIRED: Used for HMAC-SHA512 webhook verification

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...     # REQUIRED if PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...     # REQUIRED
FLUTTERWAVE_WEBHOOK_SECRET=                 # REQUIRED

# Pricing
FEATURED_SUBSCRIPTION_PRICE_MINOR=1000      # OPTIONAL: Price in minor units. Default: 1000 (e.g. $10.00)
FEATURED_SUBSCRIPTION_CURRENCY=USD          # OPTIONAL: Default currency. Default: USD
FEATURED_SUBSCRIPTION_DURATION_DAYS=30      # OPTIONAL: Featured period length. Default: 30 days

# -----------------------------------------------------------------------------
# GEOLOCATION
# -----------------------------------------------------------------------------
GEO_DEFAULT_SEARCH_RADIUS_KM=10             # OPTIONAL: Fallback radius. Default: 10 km
GEO_MAX_SEARCH_RADIUS_KM=100               # OPTIONAL: Hard cap. Default: 100 km
GEO_IP_LOOKUP_ENABLED=false                 # OPTIONAL: IP-based geo lookup. Advisory only. Default: false
GEO_IP_LOOKUP_API_KEY=                      # OPTIONAL: API key for IP geolocation service

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true                     # OPTIONAL: Disable in test. Default: true
RATE_LIMIT_LOGIN_WINDOW_MS=300000           # OPTIONAL: 5 min window for login. Default: 300000
RATE_LIMIT_LOGIN_MAX=5                      # OPTIONAL: Max login attempts per window. Default: 5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000       # OPTIONAL: 1 hour. Default: 3600000
RATE_LIMIT_REGISTER_MAX=3                   # OPTIONAL: Default: 3
RATE_LIMIT_SEARCH_WINDOW_MS=60000           # OPTIONAL: 1 minute. Default: 60000
RATE_LIMIT_SEARCH_MAX=60                    # OPTIONAL: Default: 60 per minute per user
RATE_LIMIT_MESSAGE_WINDOW_MS=60000          # OPTIONAL: Default: 60000
RATE_LIMIT_MESSAGE_MAX=30                   # OPTIONAL: Per conversation. Default: 30

# -----------------------------------------------------------------------------
# BUSINESS LOGIC THRESHOLDS
# -----------------------------------------------------------------------------
# Reviews
REVIEW_WINDOW_HOURS=168                     # OPTIONAL: Hours after booking to leave review. Default: 168 (7 days)
REVIEW_MIN_BOOKING_STATUS=COMPLETED         # FIXED: Do not change.

# Response rate
RESPONSE_RATE_WINDOW_HOURS=48               # OPTIONAL: Assignment response window. Default: 48 hours
RESPONSE_RATE_MIN_ASSIGNMENTS=3             # OPTIONAL: Min assignments before rate shown. Default: 3

# Worker aggregates
WORKER_COLD_START_BOOST_DAYS=30             # OPTIONAL: Days new worker gets cold-start ranking boost. Default: 30
WORKER_STALE_PROFILE_DAYS=180               # OPTIONAL: Days until last_active_at flags profile stale. Default: 180

# Service request
SERVICE_REQUEST_DEFAULT_EXPIRY_HOURS=48     # OPTIONAL: Hours before OPEN request auto-expires. Default: 48
SERVICE_REQUEST_MAX_ASSIGNMENTS=10          # OPTIONAL: Max workers assigned per request. Default: 10
SERVICE_REQUEST_PREFERRED_WORKER_PRIORITY=true # OPTIONAL: Preferred worker gets first assignment. Default: true

# Booking
BOOKING_CONFLICT_BUFFER_MINUTES=30         # OPTIONAL: Buffer between consecutive bookings. Default: 30 min
BOOKING_AUTO_COMPLETE_HOURS=24             # OPTIONAL: Hours after scheduled_end to auto-complete. Default: 24

# Featured subscription expiry warning
FEATURED_EXPIRY_WARNING_DAYS=7             # OPTIONAL: Days before expiry to send warning. Default: 7

# Fraud
FRAUD_SCORE_MODERATION_THRESHOLD=70        # OPTIONAL: Score to auto-create moderation case. Default: 70
FRAUD_SCORE_AUTO_SUSPEND_THRESHOLD=90      # OPTIONAL: Score to trigger auto-suspend review. Default: 90

# Support ticket
SUPPORT_TICKET_AUTO_CLOSE_DAYS=7          # OPTIONAL: Days after RESOLVED with no reply to auto-close. Default: 7

# -----------------------------------------------------------------------------
# PAGINATION
# -----------------------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20               # OPTIONAL: Default page size. Default: 20
PAGINATION_MAX_LIMIT=100                  # OPTIONAL: Hard cap on limit param. Default: 100

# -----------------------------------------------------------------------------
# WEBSOCKET
# -----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_MS=30000            # OPTIONAL: Ping interval. Default: 30 seconds
WS_PRESENCE_TTL_SECONDS=45               # OPTIONAL: Presence key TTL in Redis. Default: 45 seconds
WS_MAX_PAYLOAD_BYTES=65536               # OPTIONAL: Max message payload size. Default: 64 KB
WS_AUTH_TIMEOUT_MS=10000                 # OPTIONAL: Time to authenticate after connect. Default: 10 seconds
WS_MAX_CONNECTIONS_PER_USER=5            # OPTIONAL: Max concurrent WS connections per user. Default: 5

# -----------------------------------------------------------------------------
# BACKGROUND JOBS — BullMQ
# -----------------------------------------------------------------------------
BULLMQ_CONCURRENCY_NOTIFICATIONS=10      # OPTIONAL: Default: 10
BULLMQ_CONCURRENCY_ANALYTICS=2           # OPTIONAL: Default: 2
BULLMQ_CONCURRENCY_SEARCH=4              # OPTIONAL: Default: 4
BULLMQ_CONCURRENCY_BILLING=1             # OPTIONAL: Default: 1
BULLMQ_CONCURRENCY_MODERATION=4          # OPTIONAL: Default: 4
BULLMQ_CONCURRENCY_MEDIA_IMAGE=4         # OPTIONAL: Default: 4
BULLMQ_CONCURRENCY_MEDIA_VIDEO=2         # OPTIONAL: Default: 2
BULLMQ_JOB_RETENTION_COMPLETED_MS=86400000  # OPTIONAL: Keep completed jobs 24h. Default: 86400000
BULLMQ_JOB_RETENTION_FAILED_MS=604800000    # OPTIONAL: Keep failed jobs 7 days. Default: 604800000

# Cron schedules (cron syntax, UTC)
CRON_ANALYTICS_ROLLUP=0 * * * *           # OPTIONAL: Every hour. Default: 0 * * * *
CRON_SUBSCRIPTION_EXPIRY=*/15 * * * *     # OPTIONAL: Every 15 min. Default: */15 * * * *
CRON_FRAUD_EVALUATOR=0 * * * *            # OPTIONAL: Every hour. Default: 0 * * * *
CRON_SEARCH_REINDEX=0 2 * * *             # OPTIONAL: 02:00 UTC daily. Default: 0 2 * * *
CRON_AUDIT_INTEGRITY=0 3 * * *            # OPTIONAL: 03:00 UTC daily. Default: 0 3 * * *
CRON_TOKEN_CLEANUP=0 4 * * *              # OPTIONAL: 04:00 UTC daily. Default: 0 4 * * *
CRON_PARTITION_CREATE=0 1 1 * *           # OPTIONAL: 1st of month 01:00. Default: 0 1 1 * *

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
LOG_LEVEL=info                            # OPTIONAL: error | warn | info | debug. Default: info
LOG_FORMAT=json                           # OPTIONAL: json | pretty. Use json in production. Default: json
LOG_REQUEST_BODY=false                    # OPTIONAL: Log request bodies. NEVER true in production. Default: false
CORRELATION_ID_HEADER=X-Request-ID        # OPTIONAL: Header name for request tracing. Default: X-Request-ID

# OpenTelemetry
OTEL_ENABLED=false                        # OPTIONAL: Enable distributed tracing. Default: false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 # OPTIONAL: OTLP exporter endpoint
OTEL_SERVICE_NAME=api-server              # OPTIONAL: Override service name in traces
OTEL_TRACE_SAMPLE_RATE=0.1               # OPTIONAL: 10% sampling in production. Default: 0.1

# Metrics
METRICS_ENABLED=false                     # OPTIONAL: Prometheus metrics. Default: false
METRICS_PORT=9090                         # OPTIONAL: Metrics server port. Default: 9090

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12                          # OPTIONAL: bcrypt cost factor. Default: 12. Min: 10.
PASSWORD_MIN_LENGTH=8                     # OPTIONAL: Default: 8
PASSWORD_REQUIRE_UPPERCASE=true           # OPTIONAL: Default: true
PASSWORD_REQUIRE_DIGIT=true               # OPTIONAL: Default: true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# REQUIRED: Comma-separated list of allowed origins. NO trailing slash.
CORS_MAX_AGE_SECONDS=86400                # OPTIONAL: Preflight cache. Default: 86400

# CSRF / idempotency
IDEMPOTENCY_KEY_TTL_SECONDS=86400         # OPTIONAL: 24 hours. Default: 86400

# Content Security Policy
CSP_ENABLED=true                          # OPTIONAL: Add CSP header. Default: true

# Admin session security
ADMIN_SESSION_MFA_REQUIRED_PERMISSIONS=USER_SUSPEND,WORKER_VERIFY,CONFIG_UPDATE,ADMIN_ROLE_ASSIGN,ADMIN_ROLE_REMOVE
# OPTIONAL: Comma-separated permission keys requiring mfa_verified=true. See Part 7.

# -----------------------------------------------------------------------------
# FEATURE FLAGS (bootstrap defaults — overridden by DB feature_flags table)
# -----------------------------------------------------------------------------
FF_ENABLE_VIDEO_PORTFOLIO=false           # OPTIONAL: Default: false
FF_SEMANTIC_SEARCH_V2=false               # OPTIONAL: Default: false
FF_SHOW_WORKER_EARNINGS=false             # OPTIONAL: Default: false
FF_MULTI_CURRENCY=false                   # OPTIONAL: Default: false

# -----------------------------------------------------------------------------
# MULTI-CITY
# -----------------------------------------------------------------------------
DEFAULT_CITY_SLUG=accra                   # REQUIRED: Fallback city when user has no city set
DEFAULT_COUNTRY_CODE=GH                   # REQUIRED: Fallback country code. ISO 3166-1 alpha-2
DEFAULT_CURRENCY_CODE=GHS                 # REQUIRED: Fallback currency. ISO 4217
DEFAULT_TIMEZONE=Africa/Accra             # REQUIRED: Fallback timezone. IANA

# -----------------------------------------------------------------------------
# INTERNAL SERVICE COMMUNICATION
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_KEY=change-this-secret-key
# REQUIRED: Shared secret for /api/v1/internal/* endpoints. Use long random string.

# Service URLs (for inter-service HTTP calls in multi-container setup)
MEDIA_WORKER_URL=http://worker-media:3000
NOTIFICATION_WORKER_URL=http://worker-notifications:3000

# -----------------------------------------------------------------------------
# SEED AND TESTING
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@vocationalplatform.com    # OPTIONAL: Super admin seed account email
SEED_ADMIN_PASSWORD=Change-This-Password-123!    # OPTIONAL: Super admin seed password
SEED_ENABLED=true                                # OPTIONAL: Run seed on migrate. Default: true in dev
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/vocational_test
# REQUIRED in CI: Separate test database

# =============================================================================
# END OF .env.example
# =============================================================================
